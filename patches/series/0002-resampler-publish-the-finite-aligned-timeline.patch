+    static uint64_t roundedFrameCount(uint64_t n, uint64_t sfs, uint64_t dfs) {
+      // Round n * dfs / sfs to the nearest destination frame, with exact
+      // half-frame ties rounded up. Split at source-frame boundaries so the
+      // multiplication involving stream length cannot overflow first.
+      const uint64_t whole = n / sfs;
+      const uint64_t remainder = n % sfs;
+      if (whole != 0 && dfs > std::numeric_limits<uint64_t>::max() / whole)
+	throw(std::overflow_error("SSRCStage output frame count overflow"));
+      const uint64_t base = whole * dfs;
+
+      if (remainder != 0 && dfs > std::numeric_limits<uint64_t>::max() / remainder)
+	throw(std::overflow_error("SSRCStage output frame remainder overflow"));
+      const uint64_t numerator = remainder * dfs;
+      const uint64_t quotient = numerator / sfs;
+      const uint64_t residual = numerator % sfs;
+      const uint64_t roundedRemainder = quotient + (residual >= (sfs + 1) / 2 ? 1 : 0);
+      if (roundedRemainder > std::numeric_limits<uint64_t>::max() - base)
+	throw(std::overflow_error("SSRCStage output frame count overflow"));
+      return base + roundedRemainder;
+    }
+
+    class CountingOutlet : public ssrc::StageOutlet<REAL> {
+      std::shared_ptr<ssrc::StageOutlet<REAL>> inlet;
+      uint64_t framesRead = 0;
+      bool endReached = false;
+    public:
+      CountingOutlet(std::shared_ptr<ssrc::StageOutlet<REAL>> inlet_) : inlet(inlet_) {}
+
+      bool atEnd() { return endReached || inlet->atEnd(); }
+
+      size_t read(REAL *out, size_t nSamples) {
+	size_t nRead = inlet->read(out, nSamples);
+	if (nRead == 0) endReached = true;
+	else framesRead += nRead;
+	return nRead;
+      }
+
+      uint64_t size() const { return framesRead; }
+      bool ended() const { return endReached; }
+    };
