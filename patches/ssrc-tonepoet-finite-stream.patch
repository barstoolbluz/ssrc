--- /dev/null
+++ b/src/tester/test_finite_stream.cpp
@@ -0,0 +1,431 @@
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <cstdint>
+#include <cstring>
+#include <filesystem>
+#include <fstream>
+#include <iostream>
+#include <memory>
+#include <numeric>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+#include "shibatch/ssrc.hpp"
+
+using namespace std;
+using namespace ssrc;
+
+namespace {
+
+void require(bool condition, const string &message) {
+  if (!condition) throw runtime_error(message);
+}
+
+uint16_t u16le(const vector<uint8_t> &b, size_t p) {
+  require(p + 2 <= b.size(), "truncated u16");
+  return uint16_t(b[p]) | (uint16_t(b[p + 1]) << 8);
+}
+
+uint32_t u32le(const vector<uint8_t> &b, size_t p) {
+  require(p + 4 <= b.size(), "truncated u32");
+  uint32_t v = 0;
+  for(unsigned i=0;i<4;i++) v |= uint32_t(b[p + i]) << (i * 8);
+  return v;
+}
+
+uint64_t u64le(const vector<uint8_t> &b, size_t p) {
+  require(p + 8 <= b.size(), "truncated u64");
+  uint64_t v = 0;
+  for(unsigned i=0;i<8;i++) v |= uint64_t(b[p + i]) << (i * 8);
+  return v;
+}
+
+vector<uint8_t> readFile(const filesystem::path &path) {
+  ifstream f(path, ios::binary);
+  require(f.good(), "cannot open " + path.string());
+  f.seekg(0, ios::end);
+  const auto n = f.tellg();
+  require(n >= 0, "cannot size " + path.string());
+  f.seekg(0, ios::beg);
+  vector<uint8_t> b(static_cast<size_t>(n));
+  if (!b.empty()) f.read(reinterpret_cast<char *>(b.data()), b.size());
+  require(f.good() || f.eof(), "cannot read " + path.string());
+  return b;
+}
+
+struct ParsedWave {
+  enum class Kind { RIFF, RF64, W64 } kind;
+  uint16_t formatTag = 0, subFormatTag = 0, channels = 0, blockAlign = 0, bitsPerSample = 0;
+  uint32_t sampleRate = 0;
+  uint64_t dataBytes = 0;
+  bool hasFact = false;
+  uint64_t factFrames = 0;
+  size_t factBodyBytes = 0;
+  bool hasDs64 = false;
+  uint64_t ds64RiffSize = 0, ds64DataSize = 0, ds64SampleCount = 0;
+};
+
+constexpr array<uint8_t,16> W64_RIFF = {0x72,0x69,0x66,0x66,0x2e,0x91,0xcf,0x11,0xa5,0xd6,0x28,0xdb,0x04,0xc1,0x00,0x00};
+constexpr array<uint8_t,16> W64_WAVE = {0x77,0x61,0x76,0x65,0xf3,0xac,0xd3,0x11,0x8c,0xd1,0x00,0xc0,0x4f,0x8e,0xdb,0x8a};
+constexpr array<uint8_t,16> W64_FMT  = {0x66,0x6d,0x74,0x20,0xf3,0xac,0xd3,0x11,0x8c,0xd1,0x00,0xc0,0x4f,0x8e,0xdb,0x8a};
+constexpr array<uint8_t,16> W64_FACT = {0x66,0x61,0x63,0x74,0xf3,0xac,0xd3,0x11,0x8c,0xd1,0x00,0xc0,0x4f,0x8e,0xdb,0x8a};
+constexpr array<uint8_t,16> W64_DATA = {0x64,0x61,0x74,0x61,0xf3,0xac,0xd3,0x11,0x8c,0xd1,0x00,0xc0,0x4f,0x8e,0xdb,0x8a};
+
+bool guidAt(const vector<uint8_t> &b, size_t p, const array<uint8_t,16> &g) {
+  return p + g.size() <= b.size() && equal(g.begin(), g.end(), b.begin() + p);
+}
+
+ParsedWave parseWave(const filesystem::path &path) {
+  const vector<uint8_t> b = readFile(path);
+  ParsedWave r;
+
+  if (guidAt(b, 0, W64_RIFF)) {
+    r.kind = ParsedWave::Kind::W64;
+    require(b.size() >= 40 && guidAt(b, 24, W64_WAVE), "invalid Wave64 root");
+    require(u64le(b, 16) == b.size(), "Wave64 root size mismatch");
+
+    size_t pos = 40;
+    bool gotFmt = false, gotData = false;
+    while(pos + 24 <= b.size()) {
+      require((pos & 7) == 0, "Wave64 chunk is not 8-byte aligned");
+      const uint64_t chunkSize = u64le(b, pos + 16);
+      require(chunkSize >= 24 && chunkSize <= b.size() - pos, "invalid Wave64 chunk size");
+      const size_t body = static_cast<size_t>(chunkSize - 24);
+      const size_t bodyPos = pos + 24;
+
+      if (guidAt(b, pos, W64_FMT)) {
+        require(body >= 16, "short Wave64 fmt");
+        r.formatTag = u16le(b, bodyPos);
+        r.channels = u16le(b, bodyPos + 2);
+        r.sampleRate = u32le(b, bodyPos + 4);
+        r.blockAlign = u16le(b, bodyPos + 12);
+        r.bitsPerSample = u16le(b, bodyPos + 14);
+        if (r.formatTag == WavFormat::EXTENSIBLE) {
+          require(body >= 40 && u16le(b, bodyPos + 16) >= 22, "short extensible fmt");
+          r.subFormatTag = u16le(b, bodyPos + 24);
+        }
+        gotFmt = true;
+      } else if (guidAt(b, pos, W64_FACT)) {
+        require(body == 8, "Wave64 fact body must be exactly eight bytes");
+        r.hasFact = true;
+        r.factBodyBytes = body;
+        r.factFrames = u64le(b, bodyPos);
+      } else if (guidAt(b, pos, W64_DATA)) {
+        r.dataBytes = body;
+        gotData = true;
+      }
+
+      const uint64_t padded = (chunkSize + 7) & ~uint64_t(7);
+      require(padded <= b.size() - pos, "Wave64 padded chunk exceeds file");
+      pos += static_cast<size_t>(padded);
+    }
+    require(pos == b.size(), "Wave64 trailing bytes");
+    require(gotFmt && gotData, "Wave64 missing fmt or data");
+    return r;
+  }
+
+  require(b.size() >= 12, "short RIFF/RF64 file");
+  const bool rf64 = memcmp(b.data(), "RF64", 4) == 0;
+  require(rf64 || memcmp(b.data(), "RIFF", 4) == 0, "unknown wave container");
+  require(memcmp(b.data() + 8, "WAVE", 4) == 0, "missing WAVE form type");
+  r.kind = rf64 ? ParsedWave::Kind::RF64 : ParsedWave::Kind::RIFF;
+  if (rf64) require(u32le(b, 4) == 0xffffffffU, "RF64 root size sentinel missing");
+  else require(u32le(b, 4) == b.size() - 8, "RIFF root size mismatch");
+
+  size_t pos = 12;
+  bool gotFmt = false, gotData = false;
+  while(pos + 8 <= b.size()) {
+    const string id(reinterpret_cast<const char *>(b.data() + pos), 4);
+    const uint32_t size32 = u32le(b, pos + 4);
+    const size_t bodyPos = pos + 8;
+    uint64_t body = size32;
+    if (rf64 && id == "data" && size32 == 0xffffffffU) {
+      require(r.hasDs64, "RF64 data precedes ds64");
+      body = r.ds64DataSize;
+    }
+    require(body <= b.size() - bodyPos, "chunk exceeds file");
+
+    if (id == "ds64") {
+      require(rf64 && body >= 28, "invalid ds64");
+      r.hasDs64 = true;
+      r.ds64RiffSize = u64le(b, bodyPos);
+      r.ds64DataSize = u64le(b, bodyPos + 8);
+      r.ds64SampleCount = u64le(b, bodyPos + 16);
+      require(u32le(b, bodyPos + 24) == 0, "unexpected RF64 ds64 table");
+    } else if (id == "fmt ") {
+      require(body >= 16, "short fmt");
+      r.formatTag = u16le(b, bodyPos);
+      r.channels = u16le(b, bodyPos + 2);
+      r.sampleRate = u32le(b, bodyPos + 4);
+      r.blockAlign = u16le(b, bodyPos + 12);
+      r.bitsPerSample = u16le(b, bodyPos + 14);
+      if (r.formatTag == WavFormat::EXTENSIBLE) {
+        require(body >= 40 && u16le(b, bodyPos + 16) >= 22, "short extensible fmt");
+        r.subFormatTag = u16le(b, bodyPos + 24);
+      }
+      gotFmt = true;
+    } else if (id == "fact") {
+      require(body == 4, "RIFF/RF64 fact body must be four bytes");
+      r.hasFact = true;
+      r.factBodyBytes = static_cast<size_t>(body);
+      r.factFrames = u32le(b, bodyPos);
+    } else if (id == "data") {
+      r.dataBytes = body;
+      gotData = true;
+    }
+
+    const uint64_t paddedBody = body + (body & 1);
+    require(paddedBody <= b.size() - bodyPos, "padded chunk exceeds file");
+    pos = bodyPos + static_cast<size_t>(paddedBody);
+  }
+  require(pos == b.size(), "RIFF/RF64 trailing bytes");
+  require(gotFmt && gotData, "RIFF/RF64 missing fmt or data");
+  if (rf64) {
+    require(r.hasDs64, "RF64 missing ds64");
+    require(r.ds64RiffSize == b.size() - 8, "RF64 ds64 RIFF size mismatch");
+    require(r.ds64DataSize == r.dataBytes, "RF64 ds64 data size mismatch");
+  }
+  return r;
+}
+
+template<typename T>
+class VectorOutlet : public StageOutlet<T> {
+  vector<T> data;
+  size_t pos = 0;
+public:
+  explicit VectorOutlet(vector<T> data_) : data(std::move(data_)) {}
+  bool atEnd() override { return pos == data.size(); }
+  size_t read(T *out, size_t n) override {
+    const size_t z = min(n, data.size() - pos);
+    if (z != 0) memcpy(out, data.data() + pos, z * sizeof(T));
+    pos += z;
+    return z;
+  }
+};
+
+uint64_t roundedFrames(uint64_t n, uint64_t fs, uint64_t fd) {
+  const uint64_t q = n / fs, r = n % fs;
+  const uint64_t numerator = r * fd;
+  return q * fd + numerator / fs + ((numerator % fs) >= (fs + 1) / 2 ? 1 : 0);
+}
+
+template<typename T>
+vector<T> resample(const vector<T> &input, uint32_t fs, uint32_t fd,
+                   unsigned l2dft, double aa, double guard,
+                   bool minPhase = false, unsigned l2min = 0, bool mt = true,
+                   size_t chunk = 257) {
+  auto source = make_shared<VectorOutlet<T>>(input);
+  SSRC<T> converter(source, fs, fd, l2dft, aa, guard, 1.0, minPhase, l2min, mt);
+  require(converter.getDelay() == 0, "published finite stream must report zero latency");
+
+  vector<T> out, buf(chunk);
+  for(;;) {
+    const size_t z = converter.read(buf.data(), buf.size());
+    if (z == 0) break;
+    out.insert(out.end(), buf.begin(), buf.begin() + z);
+    require(out.size() <= roundedFrames(input.size(), fs, fd), "resampler published beyond finite endpoint");
+  }
+  require(out.size() == roundedFrames(input.size(), fs, fd), "wrong finite output frame count");
+  require(converter.atEnd(), "resampler not at end after finite output");
+  return out;
+}
+
+template<typename T>
+void writeContainer(const filesystem::path &path, ContainerFormat container, uint16_t formatTag,
+                    uint16_t bits, size_t frames, unsigned channels, const uint8_t *subFormat = nullptr) {
+  vector<shared_ptr<StageOutlet<T>>> inputs;
+  for(unsigned ch=0;ch<channels;ch++) {
+    vector<T> v(frames);
+    for(size_t i=0;i<frames;i++) v[i] = static_cast<T>((i + 1) * 0.001 + ch * 0.125);
+    inputs.push_back(make_shared<VectorOutlet<T>>(std::move(v)));
+  }
+  WavFormat fmt(formatTag, channels, 48000, bits, subFormat != nullptr ? 3 : 0, subFormat);
+  {
+    WavWriter<T> writer(path.string(), fmt, container, inputs, 0, 37, true);
+    writer.execute();
+  }
+}
+
+void testContainers(const filesystem::path &tmp) {
+  struct ContainerCase { const char *name; ContainerFormat container; ParsedWave::Kind kind; };
+  const array<ContainerCase,3> containers = {{
+    {"riff", ContainerFormat::RIFF, ParsedWave::Kind::RIFF},
+    {"w64",  ContainerFormat::W64,  ParsedWave::Kind::W64},
+    {"rf64", ContainerFormat::RF64, ParsedWave::Kind::RF64},
+  }};
+  constexpr size_t frames = 257;
+  constexpr unsigned channels = 2;
+
+  for(const auto &c : containers) {
+    for(unsigned bits : {32U, 64U}) {
+      const auto path = tmp / (string("finite-float-") + to_string(bits) + "." + c.name);
+      if (bits == 32) writeContainer<float>(path, c.container, WavFormat::IEEE_FLOAT, bits, frames, channels);
+      else writeContainer<double>(path, c.container, WavFormat::IEEE_FLOAT, bits, frames, channels);
+
+      const auto p = parseWave(path);
+      require(p.kind == c.kind, "container kind mismatch");
+      require(p.formatTag == WavFormat::IEEE_FLOAT, "floating output is not IEEE float");
+      require(p.channels == channels && p.sampleRate == 48000, "floating fmt geometry mismatch");
+      require(p.bitsPerSample == bits && p.blockAlign == channels * bits / 8, "floating block alignment mismatch");
+      require(p.dataBytes == frames * p.blockAlign, "floating data extent mismatch");
+      require(p.hasFact, "floating output missing fact metadata");
+      require(p.factFrames == (c.kind == ParsedWave::Kind::RF64 ? 0xffffffffULL : frames),
+              "floating fact frame count/sentinel mismatch");
+      require(p.factBodyBytes == (c.kind == ParsedWave::Kind::W64 ? 8U : 4U), "wrong fact field width");
+      if (c.kind == ParsedWave::Kind::RF64)
+        require(p.ds64SampleCount == frames, "RF64 ds64 sample count mismatch");
+      filesystem::remove(path);
+    }
+
+    const auto extFloatPath = tmp / (string("finite-ext-float64.") + c.name);
+    writeContainer<double>(extFloatPath, c.container, WavFormat::EXTENSIBLE, 64, frames, channels,
+                           WavFormat::KSDATAFORMAT_SUBTYPE_IEEE_FLOAT);
+    const auto extFloat = parseWave(extFloatPath);
+    require(extFloat.formatTag == WavFormat::EXTENSIBLE && extFloat.subFormatTag == WavFormat::IEEE_FLOAT,
+            "extensible floating fmt subtype mismatch");
+    require(extFloat.dataBytes == frames * extFloat.blockAlign, "extensible floating data extent mismatch");
+    require(extFloat.hasFact, "extensible floating output missing fact metadata");
+    require(extFloat.factFrames == (c.kind == ParsedWave::Kind::RF64 ? 0xffffffffULL : frames),
+            "extensible floating fact frame count/sentinel mismatch");
+    if (c.kind == ParsedWave::Kind::RF64)
+      require(extFloat.ds64SampleCount == frames, "extensible RF64 ds64 sample count mismatch");
+    filesystem::remove(extFloatPath);
+
+    const auto intPath = tmp / (string("finite-int32.") + c.name);
+    writeContainer<int32_t>(intPath, c.container, WavFormat::PCM, 32, frames, channels);
+    const auto p = parseWave(intPath);
+    require(p.formatTag == WavFormat::PCM, "integer output is not PCM");
+    require(!p.hasFact, "integer PCM unexpectedly gained fact metadata");
+    require(p.dataBytes == frames * p.blockAlign, "integer data extent mismatch");
+    if (c.kind == ParsedWave::Kind::RF64)
+      require(p.ds64SampleCount == 0, "RF64 integer ds64 sample count changed");
+    filesystem::remove(intPath);
+
+    const auto extIntPath = tmp / (string("finite-ext-int32.") + c.name);
+    writeContainer<int32_t>(extIntPath, c.container, WavFormat::EXTENSIBLE, 32, frames, channels,
+                            WavFormat::KSDATAFORMAT_SUBTYPE_PCM);
+    const auto extInt = parseWave(extIntPath);
+    require(extInt.formatTag == WavFormat::EXTENSIBLE && extInt.subFormatTag == WavFormat::PCM,
+            "extensible integer fmt subtype mismatch");
+    require(!extInt.hasFact, "extensible integer PCM unexpectedly gained fact metadata");
+    require(extInt.dataBytes == frames * extInt.blockAlign, "extensible integer data extent mismatch");
+    if (c.kind == ParsedWave::Kind::RF64)
+      require(extInt.ds64SampleCount == 0, "extensible RF64 integer ds64 sample count changed");
+    filesystem::remove(extIntPath);
+  }
+}
+
+void testFrameExtents() {
+  struct RatePair { uint32_t fs, fd; };
+  const array<RatePair,4> rates = {{{44100,48000}, {48000,44100}, {48000,96000}, {96000,44100}}};
+  // 17/130 straddle the 44.1 -> 48 kHz half-frame boundary; 43/80/117
+  // straddle and hit the exact 48 -> 44.1 kHz half-frame tie.
+  const array<size_t,12> lengths = {{1,2,17,43,80,117,130,1023,1024,12544,44101,48001}};
+
+  for(const auto &rate : rates) {
+    for(size_t n : lengths) {
+      vector<double> input(n, 1.25);
+      const auto out = resample(input, rate.fs, rate.fd, 10, 96, 1);
+      require(out.size() == roundedFrames(n, rate.fs, rate.fd), "rate-pair extent mismatch");
+    }
+  }
+
+  struct Profile { unsigned l2; double aa, guard; };
+  vector<double> fixture(12544, -1.5);
+  for(const auto &profile : array<Profile,2>{{{14,145,2}, {16,170,4}}}) {
+    for(const auto &rate : array<RatePair,2>{{{44100,48000}, {48000,44100}}}) {
+      (void)resample(fixture, rate.fs, rate.fd, profile.l2, profile.aa, profile.guard, false, 0, true);
+      (void)resample(fixture, rate.fs, rate.fd, profile.l2, profile.aa, profile.guard, false, 0, false);
+    }
+  }
+
+  (void)resample(fixture, 44100, 48000, 14, 145, 2, false, 8, true);
+  (void)resample(fixture, 48000, 44100, 14, 145, 2, false, 8, false);
+  (void)resample(fixture, 44100, 48000, 14, 145, 2, true, 0, true);
+  (void)resample(fixture, 48000, 44100, 14, 145, 2, true, 0, false);
+}
+
+double impulseCentroid(const vector<double> &v) {
+  long double weighted = 0, energy = 0;
+  for(size_t i=0;i<v.size();i++) {
+    const long double e = static_cast<long double>(v[i]) * v[i];
+    weighted += static_cast<long double>(i) * e;
+    energy += e;
+  }
+  require(energy > 0, "impulse output has zero energy");
+  return static_cast<double>(weighted / energy);
+}
+
+void testTimelineMapping() {
+  constexpr size_t n = 20000, impulse = 10000;
+  vector<double> x(n, 0);
+  x[impulse] = 1;
+
+  for(const auto &rate : array<array<uint32_t,2>,2>{{{{44100,48000}}, {{48000,44100}}}}) {
+    const auto y = resample(x, rate[0], rate[1], 14, 145, 2);
+    const double expected = impulse * static_cast<double>(rate[1]) / rate[0];
+    const double centroid = impulseCentroid(y);
+    require(abs(centroid - expected) < 1e-3, "linear-phase impulse is not on the rational destination timeline");
+  }
+
+  vector<double> edgeSilence(12544, 0);
+  fill(edgeSilence.begin() + 1000, edgeSilence.end() - 1000, 0.75);
+  const auto silentEdges = resample(edgeSilence, 44100, 48000, 10, 96, 1);
+  require(silentEdges.size() == roundedFrames(edgeSilence.size(), 44100, 48000), "source silence changed finite extent");
+
+  vector<double> firstLastZero(12544, 0.5);
+  firstLastZero.front() = 0;
+  firstLastZero.back() = 0;
+  const auto zeroEndpoints = resample(firstLastZero, 48000, 44100, 10, 96, 1);
+  require(zeroEndpoints.size() == roundedFrames(firstLastZero.size(), 48000, 44100), "zero endpoint samples changed finite extent");
+
+  vector<double> left(12544, 0.25), right(12544, -0.75);
+  left[4000] = 1.5;
+  fill(right.begin(), right.begin() + 500, 0);
+  const auto leftOut = resample(left, 44100, 48000, 10, 96, 1);
+  const auto rightOut = resample(right, 44100, 48000, 10, 96, 1);
+  require(leftOut.size() == rightOut.size(), "multichannel material produced inconsistent channel extents");
+}
+
+void testNumerics() {
+  constexpr size_t segment = 12000;
+  const array<double,5> levels = {{1.5, -1.5, 2.0, -2.0, 1e-12}};
+  vector<double> x;
+  for(double level : levels) x.insert(x.end(), segment, level);
+
+  const auto y = resample(x, 44100, 48000, 14, 145, 2);
+  for(size_t s=0;s<levels.size();s++) {
+    const uint64_t srcMid = s * segment + segment / 2;
+    const uint64_t dstMid = roundedFrames(srcMid, 44100, 48000);
+    require(dstMid < y.size(), "numeric probe outside output");
+    require(isfinite(y[dstMid]), "non-finite resampler output");
+    const double tolerance = abs(levels[s]) < 1e-9 ? 1e-15 : 5e-6;
+    require(abs(y[dstMid] - levels[s]) <= tolerance,
+            "finite-stream repair changed plateau gain");
+  }
+  require(abs(y[roundedFrames(2 * segment + segment / 2, 44100, 48000)]) > 1.0,
+          "above-full-scale floating sample was clipped");
+}
+
+} // namespace
+
+int main(int argc, char **argv) {
+  try {
+    require(argc == 2, "usage: test_finite_stream <temporary-directory>");
+    const filesystem::path tmp(argv[1]);
+    filesystem::create_directories(tmp);
+
+    testContainers(tmp);
+    testFrameExtents();
+    testTimelineMapping();
+    testNumerics();
+
+    cout << "finite stream contract: PASS" << endl;
+    return 0;
+  } catch(const exception &ex) {
+    cerr << "finite stream contract: FAIL: " << ex.what() << endl;
+    return 1;
+  }
+}
